// Copy this file to Secrets.xcconfig (git-ignored) and fill in your own values.
MTD_API_KEY = your_mtd_api_key_here

// From https://console.cloud.google.com/apis/credentials — an OAuth client of type "iOS",
// Bundle ID com.rexlan.mtdbuddy, with the Google Calendar API enabled. See README.
GOOGLE_CLIENT_ID = your_client_id.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.your_client_id
